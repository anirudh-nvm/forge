# Forge AI configuration
# Copy this file to .env.local and fill in your keys.
# NEVER commit real keys. .env / .env*.local are gitignored.

# Provider selection: "gemini" | "openai"
EXPO_PUBLIC_AI_PROVIDER=gemini

# Gemini (https://aistudio.google.com/app/apikey)
EXPO_PUBLIC_GEMINI_API_KEY=

# OpenAI (https://platform.openai.com/api-keys)
EXPO_PUBLIC_OPENAI_API_KEY=

# Optional model overrides
EXPO_PUBLIC_GEMINI_MODEL=gemini-flash-latest
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
# Developer AI panel (long-press the Forge greeting on Today)
EXPO_PUBLIC_AI_DEV_PANEL=true
